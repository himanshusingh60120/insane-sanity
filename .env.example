# ─── Google Sheets (required for live sheet writing) ────────────────────────────
# Create a service account in Google Cloud, enable the Google Sheets API,
# download the JSON key, then share the sheet with the service account e-mail
# as an EDITOR. Without that share the writes fail with 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=kr-sanity@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON exactly, including the \n escapes,
# wrapped in double quotes. On Vercel, paste the real multi-line key instead.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# The id from your sheet URL: /spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=1GIw56tTNMfLd4cRk72V9GJjzMKhSqGAJVwpfMpCmRBY

# Tab names inside that spreadsheet. Create them exactly as written.
SHEET_TAB_REPORT=Report Runs
SHEET_TAB_BLOG=Blog Runs
SHEET_TAB_PR=PR Runs
SHEET_TAB_ISSUES=Issue Log

# ─── OpenAI (optional — only powers spelling / grammar / tone advisories) ───────
# Every AI finding is verified against the page source before it is shown.
# Anything the model returns that does not appear verbatim on the page is thrown
# away. Leave OPENAI_API_KEY unset and the tool still runs; those three rows just
# report "not run" instead of Yes/No.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Site config ───────────────────────────────────────────────────────────────
SITE_ORIGIN=https://www.kingsresearch.com
SITEMAP_URL=https://www.kingsresearch.com/sitemap-reports.xml

# Optional: require a shared secret in the x-kr-token header on /api/check
# so the deployment is not open to the internet.
KR_ACCESS_TOKEN=
